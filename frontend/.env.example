# Public browser-safe values only. Never put secrets in this file.

# Base URL of the MediPulse API.
# Leave unset in development to use the Vite proxy (/api -> http://localhost:4000).
VITE_API_URL=http://localhost:4000/api

# Supabase project URL and PUBLIC anon key. Both are browser-safe by design
# and rely on Row Level Security. Leave both blank to run the local demo mode.
# NEVER put the service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
