# Never commit a real .env file. Copy this file to .env and fill values locally.
# Secrets stay on the backend only; the frontend must never receive them.

# Runtime
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase (optional in this build; not required for the demo)
# The service-role key stays on the server and must never be exposed to the browser.
# This build does not read Supabase from the backend yet; leave the service-role
# key unset unless you add server-side database access that needs it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (optional). Leave blank to keep the assistant on offline guidance.
# Get a key from Google AI Studio and keep it server-side only. Never use VITE_* for it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: raise on slow networks before falling back to offline guidance (ms, 1000-300000).
# GEMINI_TIMEOUT_MS=25000
